# Replicate provider authentication
REPLICATE_API_TOKEN=r8_your_token_here

# API Authentication (Optional - leave empty for open local development)
PF_API_KEY=your_secret_api_key_here

# Operational modes
DRY_RUN=0
IOU_THRESHOLD=0.85
IOU_WARN_THRESHOLD=0.90
WARMUP_PROBE=0
PORT=8000

# Deterministic BOM assumptions
WALL_HEIGHT_M=3.0
WINDOW_HEIGHT_M=1.5
OPENING_CLUSTER_TOLERANCE_MM=250

# Browser-facing DXF upload limit (bytes)
MAX_DXF_UPLOAD_BYTES=52428800
